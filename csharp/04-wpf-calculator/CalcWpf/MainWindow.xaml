<Window x:Class="CalcWpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Калькулятор" Height="600" Width="450"
        WindowStartupLocation="CenterScreen">
    <DockPanel Margin="10">
        <ScrollViewer>
            <StackPanel>

               
                <TextBox x:Name="InputBox" Height="50" FontSize="22" Text="0"
                         HorizontalContentAlignment="Right"
                         PreviewTextInput="InputBox_PreviewTextInput"
                         PreviewKeyDown="InputBox_PreviewKeyDown"/>

                <!-- Блок системы счисления -->
                <GroupBox Header="Система счисления" Margin="0,8,0,8">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <RadioButton Content="DEC" IsChecked="True" Checked="System_Changed" Margin="5"/>
                        <RadioButton Content="BIN" Checked="System_Changed" Margin="5"/>
                        <RadioButton Content="HEX" Checked="System_Changed" Margin="5"/>
                    </StackPanel>
                </GroupBox>

                <!-- Кнопки калькулятора (сетка) -->
                <UniformGrid Columns="4" Rows="5" Margin="0,5,0,10">
                    <Button Content="7" Click="Digit_Click"/>
                    <Button Content="8" Click="Digit_Click"/>
                    <Button Content="9" Click="Digit_Click"/>
                    <Button Content="/" Click="Op_Click"/>

                    <Button Content="4" Click="Digit_Click"/>
                    <Button Content="5" Click="Digit_Click"/>
                    <Button Content="6" Click="Digit_Click"/>
                    <Button Content="*" Click="Op_Click"/>

                    <Button Content="1" Click="Digit_Click"/>
                    <Button Content="2" Click="Digit_Click"/>
                    <Button Content="3" Click="Digit_Click"/>
                    <Button Content="-" Click="Op_Click"/>

                    <Button Content="0" Click="Digit_Click"/>
                    <Button Content="." Click="Dot_Click"/>
                    <Button Content="=" Click="Equal_Click"/>
                    <Button Content="+" Click="Op_Click"/>

                    <Button Content="C" Click="Clear_Click"/>
                    <Button Content="Back" Click="Back_Click"/>
                    <Button Content="+/-" Click="Sign_Click"/>
                    <Button Content="√" Click="Sqrt_Click"/>
                </UniformGrid>

                
                <GroupBox Header="Настройка точности" Margin="0,5,0,5" Height="84">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="5">
                            <TextBlock Text="Знаков после запятой:" VerticalAlignment="Center"/>
                            <ComboBox x:Name="PrecisionCombo" Width="60" Margin="10,0,0,0"
                                      SelectionChanged="Precision_Changed">
                                <ComboBoxItem Content="0"/>
                                <ComboBoxItem Content="1"/>
                                <ComboBoxItem Content="2" IsSelected="True"/>
                                <ComboBoxItem Content="3"/>
                                <ComboBoxItem Content="4"/>
                                <ComboBoxItem Content="5"/>
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="5">
                            <TextBlock Text="Формат вывода:" VerticalAlignment="Center"/>
                            <ComboBox x:Name="FormatCombo" Width="100" Margin="10,0,0,0"
                                      SelectionChanged="Format_Changed">
                                <ComboBoxItem Content="Обычный (123.45)" IsSelected="True"/>
                                <ComboBoxItem Content="Научный (1.23e2)"/>
                            </ComboBox>
                        </StackPanel>
                    </StackPanel>
                </GroupBox>

            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>