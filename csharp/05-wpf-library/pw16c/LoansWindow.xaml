<Window x:Class="pw16c.LoansWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Выдачи"
        Height="450"
        Width="900">

    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBox Name="txtSearch"
                 Margin="5"
                 TextChanged="txtSearch_TextChanged"/>

        <DataGrid Grid.Row="1"
                  Name="dgLoans"
                  AutoGenerateColumns="False">

            <DataGrid.Columns>

                <DataGridTextColumn Header="ID"
                                    Binding="{Binding LoanID}"/>

                <DataGridTextColumn Header="ReaderID"
                                    Binding="{Binding ReaderID}"/>

                <DataGridTextColumn Header="BookID"
                                    Binding="{Binding BookID}"/>

                <DataGridTextColumn Header="Дата выдачи"
                                    Binding="{Binding IssueDate}"/>

                <DataGridTextColumn Header="Дата возврата"
                                    Binding="{Binding ReturnDate}"/>

            </DataGrid.Columns>

        </DataGrid>

        <Grid Grid.Row="2">

            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0"
                    Content="Добавить"
                    Click="Add_Click"/>

            <Button Grid.Column="1"
                    Content="Изменить"
                    Click="Edit_Click"/>

            <Button Grid.Column="2"
                    Content="Удалить"
                    Click="Delete_Click"/>

        </Grid>

    </Grid>

</Window>