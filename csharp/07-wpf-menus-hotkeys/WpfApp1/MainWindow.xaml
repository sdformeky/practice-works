<Window x:Class="WpfApp35.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp35"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800" KeyDown="Window_KeyDown" Closing="Window_Closing">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="291*"/>
            <ColumnDefinition Width="509*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Menu Grid.Row="0" Grid.ColumnSpan="2" Margin="0,0,0,416" Grid.RowSpan="2">
            <MenuItem Header="_Заливка">
                <MenuItem Header="Красный" Click="MenuItem_Click" InputGestureText="Ctrl+R"/>
                <MenuItem Header="Зеленый" Click="MenuItem_Click_1" InputGestureText="Ctrl+G"/>
                <MenuItem Header="Синий" Click="MenuItem_Click_2" InputGestureText="Ctrl+B"/>
            </MenuItem>

            <MenuItem Header="_Рамка">
                <MenuItem Header="Красный" Click="MenuItem_Click_3"/>
                <MenuItem Header="Зеленый" Click="MenuItem_Click_4"/>
                <MenuItem Header="Синий" Click="MenuItem_Click_5"/>
            </MenuItem>
            <MenuItem Header="_Толщина">
                <MenuItem Header="5" Click="MenuItem_Click_6"/>
                <MenuItem Header="10" Click="MenuItem_Click_7"/>
                <MenuItem Header="15" Click="MenuItem_Click_8"/>
            </MenuItem>
            <MenuItem Header="_История" >
                <MenuItem Header="Очистить историю" Click="MenuItem_HistoryClear" />
                <MenuItem Header="История" x:Name="HistoryMenu"/>
            </MenuItem>
        </Menu>

        <Border Grid.Row="1" x:Name="Box"
                Width="600"
                Height="300"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                BorderThickness="5"
                Background="Chocolate"
                BorderBrush="DarkGreen" Grid.ColumnSpan="2" Margin="100,0,0,0">

            <Border.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Красный" Click="MenuItem_Click" InputGestureText="Ctrl+R"/>
                    <MenuItem Header="Зеленый" Click="MenuItem_Click_1" InputGestureText="Ctrl+G"/>
                    <MenuItem Header="Синий" Click="MenuItem_Click_2" InputGestureText="Ctrl+B"/>
                    <Separator/>
                    <MenuItem Header="Красный" Click="MenuItem_Click_3"/>
                    <MenuItem Header="Зеленый" Click="MenuItem_Click_4"/>
                    <MenuItem Header="Синий" Click="MenuItem_Click_5"/>
                    <Separator/>
                    <MenuItem Header="5" Click="MenuItem_Click_6"/>
                    <MenuItem Header="10" Click="MenuItem_Click_7"/>
                    <MenuItem Header="15" Click="MenuItem_Click_8"/>
                </ContextMenu>
            </Border.ContextMenu>
        </Border>
        <Button Grid.Column="1" Content="Button" HorizontalAlignment="Left" Margin="437,67,0,0" Grid.Row="1" VerticalAlignment="Top" Height="48" Width="49" Click="Button_Click"/>
    </Grid>
</Window>