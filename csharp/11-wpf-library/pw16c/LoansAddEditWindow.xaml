<Window x:Class="pw16c.LoansAddEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:pw16c"
        mc:Ignorable="d"
        Title="LoansAddEditWindow" Height="450" Width="800">
    <StackPanel Margin="10">

        <TextBlock Text="Читатель"/>

        <ComboBox Name="cbReader"
              DisplayMemberPath="FullName"
              SelectedValuePath="ReaderID"/>

        <TextBlock Text="Книга"/>

        <ComboBox Name="cbBook"
              DisplayMemberPath="Title"
              SelectedValuePath="BookID"/>

        <TextBlock Text="Дата выдачи"/>

        <DatePicker Name="dpIssue"/>

        <TextBlock Text="Дата возврата"/>

        <DatePicker Name="dpReturn"/>

        <Button Content="Сохранить"
            Click="Save_Click"/>

    </StackPanel>
</Window>
